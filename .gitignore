# ============================================
# The Brothers Barber Shop — .gitignore
# ============================================

# ── Dependencias ──
node_modules/
.pnpm-store/
.yarn/

# ── Build / salida ──
dist/
build/
out/
frontend/dist/
frontend/build/
backend/dist/
*.tsbuildinfo
.vite/
.parcel-cache/
.turbo/
.next/

# ── Variables de entorno y secretos ──
.env
.env.*
!.env.example
!*.env.example
!backend/.env.example
!backend/.env.production.example
!frontend/.env.example
!frontend/.env.development
!frontend/.env.production
backend/config/environments/*.env
*.pem
*.key
credentials.json
cloudinary.config.js
cloudinary-config.json
config.local.js
config.local.json
config.printer.local.js

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/logs/
frontend/logs/

# ── Datos en tiempo de ejecución ──
backend/backups/
!backend/backups/.gitkeep
!backend/backups/daily/.gitkeep
!backend/backups/incremental/.gitkeep
!backend/backups/migration/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/temp/
!backend/uploads/temp/.gitkeep
backend/temp/
backend/test-results.txt

# ── Testing / cobertura ──
coverage/
.nyc_output/
cypress/screenshots/
cypress/videos/
jest-coverage/
*.lcov

# ── Instaladores y binarios pesados ──
*.deb
*.rpm
*.AppImage
*.exe
*.msi
*.dmg
*.apk

# ── Cachés y temporales ──
.cache/
.eslintcache
.rts2_cache_umd/
.rpt2_cache/
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.backup
*_backup.*
*-backup.*
*.orig
*.config.bak
*.db
*.db-journal
*.sqlite

# ── SO / IDE ──
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/*
!.vscode/extensions.json
*.code-workspace

# ── Deploy / infra ──
.vercel/
.netlify/
.pm2/
ecosystem.config.js
